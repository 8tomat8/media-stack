[Unit]
Description=Media Stack Docker Compose Service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/8tomat8/media-stack
# User= keeps root from executing the user-writable dotenvx binary; docker group membership is enough for compose.
User=8tomat8
# One line: DOTENV_PRIVATE_KEY_SECRETS=<private key, 1Password "dotenvx (02C 699)">. chmod 600, outside the repo.
EnvironmentFile=/home/8tomat8/.secrets/media-stack.keys
ExecStart=/home/8tomat8/.local/bin/dotenvx run --strict -f .env.secrets -- /usr/bin/docker compose up -d
ExecStop=/home/8tomat8/.local/bin/dotenvx run --strict -f .env.secrets -- /usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
