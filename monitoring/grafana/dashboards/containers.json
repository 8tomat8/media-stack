    {
      "type": "timeseries",
      "title": "qbittorrent torrents",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (status) (qbittorrent_torrents_count) > 0",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
