    {
      "id": 10,
      "type": "table",
      "title": "Running per project",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 15,
        "y": 4,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count by (com_docker_compose_project) (max by (com_docker_compose_project, container_name) (docker_container_status_exitcode{container_status=\"running\"}))",
          "legendFormat": "{{com_docker_compose_project}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count by (com_docker_compose_project) (max by (com_docker_compose_project, container_name) (docker_container_status_exitcode))",
          "legendFormat": "{{com_docker_compose_project}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "com_docker_compose_project",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "com_docker_compose_project": "project",
              "Value #A": "running",
              "Value #B": "total"
            }
          }
        },
        {
          "id": "transpose",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
