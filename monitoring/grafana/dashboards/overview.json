    {
      "id": 4,
      "type": "stat",
      "title": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(max by (container_name) (docker_container_status_exitcode{container_status=\"running\"})) or vector(0)",
          "legendFormat": "Running"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(max by (container_name) (docker_container_status_exitcode))",
          "legendFormat": "Containers"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(max by (container_name) (docker_container_status_exitcode{container_status!=\"running\"})) or vector(0)",
          "legendFormat": "Not running"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(max by (container_name) (docker_container_health_failing_streak{health_status=\"unhealthy\"})) or vector(0)",
          "legendFormat": "Unhealthy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
