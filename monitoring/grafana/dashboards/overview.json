    {
      "id": 12,
      "type": "timeseries",
      "title": "Network",
      "description": "vpn carries all media-app traffic; all = every container.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 17,
        "y": 9,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(docker_container_net_rx_bytes{container_name=\"vpn\",network=\"total\"}[$__rate_interval]))",
          "legendFormat": "vpn rx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(docker_container_net_tx_bytes{container_name=\"vpn\",network=\"total\"}[$__rate_interval]))",
          "legendFormat": "vpn tx"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(docker_container_net_rx_bytes{network=\"total\"}[$__rate_interval]))",
          "legendFormat": "all rx"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(docker_container_net_tx_bytes{network=\"total\"}[$__rate_interval]))",
          "legendFormat": "all tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/tx$/"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
